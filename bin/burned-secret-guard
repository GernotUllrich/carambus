#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone-Einstieg fuer die Baum-Wache (siehe lib/burned_secret_guard.rb).
# Bewusst ohne Rails-Boot.
#
# ARGV wird hier — anders als in bin/ui-hex-guard — AUSGEWERTET: overcommit
# haengt die gestagten Dateipfade an, und genau die sind im pre-commit der
# Punkt (Delta statt Vollscan, Millisekunden statt Sekunden). Ohne Argumente
# laeuft der Scan ueber den ganzen getrackten Baum — so in CI.
#
# Exit 0 = sauber, Exit 1 = verbranntes Geheimnis im Baum.

require_relative "../lib/burned_secret_guard"

exit(BurnedSecretGuard.check(ARGV) ? 0 : 1)
