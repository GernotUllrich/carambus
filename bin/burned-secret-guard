#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone-Einstieg fuer die Baum-Wache (siehe lib/burned_secret_guard.rb).
# Bewusst ohne Rails-Boot.
#
# ARGV wird hier — anders als in bin/ui-hex-guard — AUSGEWERTET: overcommit
# haengt die gestagten Dateipfade an, und genau die sind im pre-commit der
# Punkt (Delta statt Vollscan, Millisekunden statt Sekunden). Ohne Argumente
# laeuft der Scan ueber den ganzen getrackten Baum — so in CI.
#
# Exit 0 = sauber, Exit 1 = verbranntes Geheimnis im Baum, Exit 3 = die Wache
# selbst ist gescheitert (KEIN Befund). Die Trennung ist noetig, weil eine nicht
# abgefangene Ruby-Ausnahme sonst ebenfalls mit 1 endet — ein Absturz war damit
# von einem Fund nicht zu unterscheiden. Der pre-commit von carambus_state hat
# drei Naechte lang "verbranntes Geheimnis" gemeldet, wo in Wahrheit unter
# System-Ruby 2.6 `to_set` fehlte (2026-09-27).

require_relative "../lib/burned_secret_guard"

begin
  exit(BurnedSecretGuard.check(ARGV) ? 0 : 1)
rescue StandardError, ScriptError => e
  warn "Baum-Wache: WERKZEUGFEHLER — die Wache ist gescheitert, es liegt KEIN Geheimnis-Befund vor."
  warn "  #{e.class}: #{e.message}"
  warn "  #{e.backtrace&.first}"
  warn "  Ruby #{RUBY_VERSION} (#{RbConfig.ruby})"
  warn "  Haeufigste Ursache: ein System-Ruby ohne rbenv-Shims (launchd, nicht-interaktives ssh)."
  exit 3
end
