<div class="container mx-auto my-8 px-4">
  <div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h1 class="h3"><%= custom_link_to 'Seedings', seedings_path %> > Seeding #<%= @seeding.id %></h1>
      <%= button_to( 'Edit', edit_seeding_path(@seeding), method: :get, disabled: !current_user&.admin?, class: "btn btn-link") %>
    </div>

    <div class=" rounded shadow p-8">
      <div class="mb-4">
        <h5>Player</h5>
        <%# 2017 Bestands-Seedings tragen keinen Player; ohne Guard 500 statt Seite. %>
        <% if @seeding.player.present? %>
          <%= custom_link_to(@seeding.player.fullname, player_path(@seeding.player)) %>
        <% else %>
          <span class="text-gray-500 dark:text-gray-400">&mdash;</span>
        <% end %>
      </div>
      <%# Ein Seeding haengt entweder an einem Turnier ODER an einer Mannschaft
          (Seeding#exactly_one_association, tournament ist optional: true).
          Die Seite kannte nur den Turnierfall und warf fuer die 69.660
          Liga-Seedings 500. %>
      <% if @seeding.tournament.present? %>
        <div class="mb-4">
          <h5>Tournament</h5>
          <%= custom_link_to(@seeding.tournament.title, tournament_path(@seeding.tournament)) %>
        </div>
      <% elsif @seeding.league_team.present? %>
        <div class="mb-4">
          <h5>League team</h5>
          <%= custom_link_to(@seeding.league_team.name, league_team_path(@seeding.league_team)) %>
        </div>
      <% else %>
        <div class="mb-4">
          <h5>Tournament</h5>
          <span class="text-gray-500 dark:text-gray-400">&mdash;</span>
        </div>
      <% end %>
            <div class="mb-4">
        <h5>Ba state</h5>
        <%= @seeding.ba_state %>
      </div>
            <div class="mb-4">
        <h5>Position</h5>
        <%= @seeding.position %>
      </div>
            <div class="mb-4">
        <h5>Data</h5>
        <%= Seeding.result_display(@seeding) %>
      </div>
            <div class="mb-4">
        <h5>State</h5>
        <%= @seeding.state %>
      </div>
            <div class="mb-4">
        <h5>Balls goal</h5>
        <%= @seeding.balls_goal %>
      </div>
            <div class="mb-4">
        <h5>Playing discipline</h5>
        <%= @seeding.playing_discipline_id %>
      </div>
          </div>
  </div>
</div>
