<%# Anmeldung im Spielerkontext (Plan 02.1-01).

    Touch zuerst: die Ansicht laeuft auf dem Touchdisplay am Trainingstisch, also
    Ziffernblock statt Tastatur und grosszuegige Beruehrungsflaechen.

    UI-Konventionen (docs/ui-conventions.md): ausschliesslich Tailwind-Token, keine
    hartkodierten Farben, class-basierter Dark-Mode. Jeder Knopf traegt `.btn` — ein <a>
    ohne `.btn` auf farbigem Grund ist unsichtbar (a:not(.btn)-Regel in base.css). %>

<div class="max-w-2xl mx-auto p-4">
  <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
    <%= t(".title") %>
  </h1>

  <% if flash.now[:alert].present? || flash[:alert].present? %>
    <div class="mb-4 rounded-lg border border-danger-300 bg-danger-50 p-3 text-danger-800
                dark:border-danger-700 dark:bg-danger-900 dark:text-danger-100"
         role="alert">
      <%= flash.now[:alert] || flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: player_session_path, method: :post, local: true,
                data: { controller: "pin-pad" }, class: "space-y-6" do |f| %>

    <div>
      <label for="player_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
        <%= t(".choose_player") %>
      </label>
      <%# ⚠️ ALLE Mitglieder, nicht nur die mit PIN — sonst verriete die Liste, wer einen hat. %>
      <%= select_tag :player_id,
                     options_from_collection_for_select(@players, :id, :fl_name, params[:player_id]),
                     include_blank: t(".choose_player_blank"),
                     required: true,
                     class: "block w-full rounded-lg border-gray-300 bg-white py-3 text-lg
                             text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" %>
    </div>

    <div>
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
        <%= t(".pin") %>
      </span>

      <%# Die eingegebenen Stellen als Punkte — nie als Ziffern. %>
      <div class="mb-3 h-12 flex items-center justify-center rounded-lg bg-gray-100
                  text-2xl tracking-[0.5em] text-gray-900 dark:bg-gray-800 dark:text-gray-100"
           data-pin-pad-target="display" aria-live="polite"></div>

      <%= hidden_field_tag :pin, "", data: { pin_pad_target: "value" } %>

      <div class="grid grid-cols-3 gap-2">
        <% (1..9).each do |ziffer| %>
          <button type="button"
                  class="btn btn-secondary h-16 text-2xl"
                  data-action="pin-pad#push" data-digit="<%= ziffer %>"><%= ziffer %></button>
        <% end %>
        <button type="button" class="btn btn-secondary h-16 text-base"
                data-action="pin-pad#clear"><%= t(".clear") %></button>
        <button type="button" class="btn btn-secondary h-16 text-2xl"
                data-action="pin-pad#push" data-digit="0">0</button>
        <button type="button" class="btn btn-secondary h-16 text-base"
                data-action="pin-pad#back"><%= t(".backspace") %></button>
      </div>

      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t(".pin_hint") %></p>
    </div>

    <%# ⚠️ KEIN Auto-Absenden bei vier Stellen: der PIN darf 4 bis 8 Ziffern haben. %>
    <%= f.submit t(".sign_in"), class: "btn btn-primary w-full h-14 text-lg" %>
  <% end %>
</div>
