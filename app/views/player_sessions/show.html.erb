<%# Landeplatz nach der Anmeldung (Plan 02.1-01).

    ⚠️ Bewusst nur eine Bestaetigung. Der eigentliche persoenliche Bereich — eigene Adresse
    und Einwilligung pflegen, PIN aendern — ist Plan 02.1-02. %>

<div class="max-w-2xl mx-auto p-4">
  <% if flash[:notice].present? %>
    <div class="mb-4 rounded-lg border border-success-300 bg-success-50 p-3 text-success-800
                dark:border-success-700 dark:bg-success-900 dark:text-success-100"
         role="status">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-2">
    <%= t(".signed_in_as", name: @player_local.player.fl_name) %>
  </h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400"><%= t(".coming_soon") %></p>

  <%= button_to t(".sign_out"), player_session_path, method: :delete,
                class: "btn btn-secondary h-14 text-lg" %>
</div>
