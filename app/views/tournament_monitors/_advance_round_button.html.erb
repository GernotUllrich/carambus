<%# Der Knopf, der die Runde weiterschaltet — EINE Definition, zwei Orte (Betreiber-Wunsch
    2026-09-23): am Fuss von "Aktuelle Spiele - Runde N", wo der Turnierleiter waehrend der
    Runde hinsieht, und unter der Ergebnistabelle neben "update", wo korrigiert wird.

    ⚠️ `button_to` erzeugt ein EIGENES <form>. Wer den oberen Knopf klickt, waehrend unten in
    den Ergebnisfeldern etwas Ungespeichertes steht, verwirft es still — genau der in 23-01
    gemeldete Fall (6:6 auf 6:5 geaendert, "Runde abschliessen" geklickt, Aenderung weg und die
    Spiele danach abgeloest). Der sichere Weg unten bleibt deshalb bestehen, und der
    Hinweistext nennt die Reihenfolge: erst "update", dann weiterschalten. %>
<%- tournament_monitor = local_assigns[:tournament_monitor] %>
<%- if tournament_monitor.operator_gated_round_advance? && tournament_director?(current_user) %>
  <%- status = tournament_monitor.round_status %>
  <%- if status.present? && status[:open].empty? %>
    <%# Getrennte Beschriftung (Betreiber-Entscheidung 23-01): der letzte Klick beendet das
        TURNIER samt CSV-Upload in die ClubCloud — das darf nicht "Runde abschliessen" heissen.
        final_round_pending? sagt das nur, wo es belegbar ist (executor_params["GK"] gesetzt). %>
    <%- letzte_runde = tournament_monitor.final_round_pending? %>
    <div class="mt-4 border-t border-gray-300 dark:border-gray-600 pt-4">
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-2">
        <%= t("tournament_monitors.round_status.advance_order_hint") %>
      </p>
      <%= button_to (letzte_runde ? t("tournament_monitors.round_status.advance_tournament")
                                  : t("tournament_monitors.round_status.advance_round", round: status[:round])),
            advance_round_tournament_monitor_path(tournament_monitor),
            method: :post,
            class: "btn #{letzte_runde ? "btn-warning" : "btn-primary"}",
            data: { turbo_confirm: letzte_runde ? t("tournament_monitors.round_status.advance_tournament_confirm") : nil } %>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
        <%= letzte_runde ? t("tournament_monitors.round_status.advance_tournament_hint")
                         : t("tournament_monitors.round_status.advance_hint") %>
      </p>
    </div>
  <%- end %>
<%- end %>
