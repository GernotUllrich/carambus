<%- tournament_monitor = local_assigns[:tournament_monitor] %>
<%- edit_games_modus = local_assigns[:edit_games_modus] %>
<h2><%= t("tournament_monitors.game_results.game_results") %></h2>
<%# Plan 32-03: has_local_seedings? entscheidet lokale vs. globale Games (Game-Scope bleibt games.id-basiert) %>
<%- game_scope = tournament_monitor.tournament.has_local_seedings? ? "games.id >= #{Game::MIN_ID}" : "games.id < #{Game::MIN_ID}" %>
<%- has_games_to_start = tournament_monitor.table_monitors.includes(:game).where.not(game_id: nil).any? { |tm| %i[ready warmup warmup_a warmup_b match_shootout].include?(tm.state.to_sym) } %>
<% if edit_games_modus && has_games_to_start %>
  <div class="mb-4">
    <%= button_to "🎯 Spiele der Runde starten (für manuelle Eingabe)", 
        start_round_games_tournament_monitor_path(tournament_monitor), 
        method: :post, 
        class: "btn btn-warning",
        data: { confirm: "Alle Spiele werden in den 'Playing'-Status versetzt. Danach können Ergebnisse manuell eingegeben werden." } %>
    <p class="text-sm text-gray-600 dark:text-gray-300 mt-2">
      ℹ️ Schritt 1: Spiele starten → Schritt 2: Ergebnisse eingeben und "update" klicken
    </p>
  </div>
<% end %>
<div class="flex space-x-20 p-4 bg-white dark:bg-gray-800">
  <div class="w-full">
    <%= form_tag update_games_tournament_monitor_path(tournament_monitor), id: "update_games", method: :post do %>
      <table class='w-full'>
        <thead>
        <tr>
          <th><%= I18n.t("tournament_monitors.game_results.game", :default => "Game") %></th>
          <th>#</th>
          <th><%= I18n.t("tournament_monitors.game_results.playera", :default => "PlayerA") %></th>
          <th><%= I18n.t("tournament_monitors.game_results.playerb", :default => "PlayerB") %></th>
          <th colspan=2><%= I18n.t("tournament_monitors.game_results.points", :default => "Points") %></th>
          <%- if tournament_monitor.sets_to_play > 1 %>
            <th colspan=2><%= I18n.t("tournament_monitors.game_results.sets", :default => "Points") %></th>
          <%- end %>
          <th colspan=2><%= I18n.t("tournament_monitors.game_results.balls", :default => "Balls") %></th>
          <th colspan=2><%= I18n.t("tournament_monitors.game_results.innings", :default => "Innings") %></th>
          <th colspan=2><%= I18n.t("tournament_monitors.game_results.gd", :default => "GD") %></th>
          <th colspan=2><%= I18n.t("tournament_monitors.game_results.hs", :default => "HS") %></th>
          <%- if tournament_monitor.tournament.handicap_tournier? %>
            <th colspan=2><%= I18n.t("tournament_monitors.game_results.balls_goal", :default => "GD") %></th>
            <th colspan=2><%= I18n.t("tournament_monitors.game_results.balls_goal_percent", :default => "HS") %></th>
          <%- end %>
        </tr>
        </thead>
        <tbody>
        <%- games = tournament_monitor.tournament.games.where("games.id >= ?", Seeding::MIN_ID).includes(game_participations: :player).where(game_scope).to_a.sort_by { |game| game.seqno.presence || 999 } %>
        <%- games.each do |game| %>
          <%# Plan 24-01 (2026-09-23): Bis hierher galt `editable_game = game.table_monitor.present?`.
              Ein abgeloestes Spiel (Tisch schon neu besetzt) bekam damit weder Eingabefelder noch
              das `game_id`-Hidden-Field — es kam im POST gar nicht an. Genau das meldete der
              Betreiber als "Ich kann nichts aendern": zwei von vier Spielen fehlten.

              Editierbar ist jetzt, was BEENDET ist oder auf einem Tisch liegt. Ein unbespieltes
              Spiel ohne Tisch hat nichts zu korrigieren und zeigt weiterhin keine (leeren)
              Felder — das war der irritierende Teil des Betreiber-Screenshots. %>
          <% abgeloest = game.table_monitor.blank? %>
          <% editable_game = !abgeloest || game.ended_at.present? %>
          <% gpa = game.game_participations.where("role = 'playera' or role = 'Heim'").first; playera = gpa.andand.player %>
          <% gpb = game.game_participations.where("role = 'playerb' or role = 'Gast'").first; playerb = gpb.andand.player %>
          <%- if playera.present? && playerb.present? %>
            <%- seeding_state_a = game.tournament.seedings.where(player_id: playera.id).first.andand.state %>
            <%- seeding_state_b = game.tournament.seedings.where(player_id: playerb.id).first.andand.state %>
            <%- unless seeding_state_a == "no_show" || seeding_state_b == "no_show" %>
              <tr>
                <td>
                  <%= game.display_gname %>
                  <%# Betreiber-Befund 2026-09-23: Der Hinweis hing bis hierher an
                      `editable_game && abgeloest`, also am Tischbezug. Nach jedem
                      Rundenabschluss gibt der Tisch sein Spiel ab (table_populator.rb:950) —
                      der Hinweis stand damit bei JEDEM Spiel und behauptete eine Korrektur,
                      die nie stattgefunden hatte. Er haengt jetzt an der Marke, die
                      `korrigiere_schnappschuss!` beim tatsaechlichen Fixen setzt. %>
                  <%- if game.data["manual_correction_at"].present? %>
                    <span class="block text-xs text-warning-700 dark:text-warning-300">
                      <%= t("tournament_monitors.round_status.correction_manual") %>
                    </span>
                  <%- end %>
                </td>
                <td><%= game.seqno.present? ? game.seqno : select_tag("seqno_#{game.id}", options_for_select([nil] + Array(1..games.count))) %></td>
                <td><%= playera.andand.fullname %></td>
                <td><%= playerb.andand.fullname %></td>
                <td><%= gpa.andand.points %></td>
                <td><%= gpb.andand.points %></td>
                <%- if tournament_monitor.sets_to_play > 1 %>
                  <td><%= gpa.andand.points %></td>
                  <td><%= gpb.andand.points %></td>
                <%- end %>
                <td><%= edit_games_modus && editable_game ? hidden_field_tag("game_id[]", game.id) : "" %><%= edit_games_modus && editable_game ? text_field_tag("resulta[]", gpa.andand.result, size: 3, class: "border-2 border-black dark:border-white px-1") : gpa.andand.result %></td>
                <td><%= edit_games_modus && editable_game ? text_field_tag("resultb[]", gpb.andand.result, size: 3, class: "border-2 border-black dark:border-white px-1") : gpb.andand.result %></td>
                <td><%= edit_games_modus && editable_game ? text_field_tag("inningsa[]", gpa.andand.innings, size: 3, class: "border-2 border-black dark:border-white px-1") : gpa.andand.innings %></td>
                <td><%= edit_games_modus && editable_game ? text_field_tag("inningsb[]", gpb.andand.innings, size: 3, class: "border-2 border-black dark:border-white px-1") : gpb.andand.innings %></td>
                <td><%= gpa.andand.gd %></td>
                <td><%= gpb.andand.gd %></td>
                <td><%= edit_games_modus && editable_game ? text_field_tag("hsa[]", gpa.andand.hs, size: 3, class: "border-2 border-black dark:border-white px-1") : gpa.andand.hs %></td>
                <td><%= edit_games_modus && editable_game ? text_field_tag("hsb[]", gpb.andand.hs, size: 3, class: "border-2 border-black dark:border-white px-1") : gpb.andand.hs %></td>
                <%- if tournament_monitor.tournament.handicap_tournier? %>
                  <td><%= edit_games_modus && editable_game ? text_field_tag("bga[]", gpa.andand.data.andand['results'].andand['BG'].to_i, size: 3, class: "border-2 border-black dark:border-white px-1") : gpa.andand.data.andand['results'].andand['BG'].to_i %></td>
                  <td><%= edit_games_modus && editable_game ? text_field_tag("bgb[]", gpb.andand.data.andand['results'].andand['BG'].to_i, size: 3, class: "border-2 border-black dark:border-white px-1") : gpb.andand.data.andand['results'].andand['BG'].to_i %></td>
                  <td><%= edit_games_modus && editable_game ? text_field_tag("bg_pa[]", gpa.andand.data.andand['results'].andand['BG_P'].to_f, size: 3, class: "border-2 border-black dark:border-white px-1") : gpa.andand.data.andand['results'].andand['BG_P'].to_f %></td>
                  <td><%= edit_games_modus && editable_game ? text_field_tag("bg_pb[]", gpb.andand.data.andand['results'].andand['BG_P'].to_f, size: 3, class: "border-2 border-black dark:border-white px-1") : gpb.andand.data.andand['results'].andand['BG_P'].to_f %></td>
                <%- end %>
              </tr>
            <%- end %>
          <%- end %>
        <% end %>
        <p><%= edit_games_modus ? submit_tag("update", class: "btn btn-primary bg-primary-600") : "" %></p>
        </tbody>
      </table>
    <% end %>

    <%# Plan 23-01 / Nachbesserung 2026-09-23: Der sichere Ort fuer "Runde abschliessen" — direkt
        unter der Ergebnistabelle, neben "update". Der Ablauf liest sich von oben nach unten:
        Ergebnisse sehen → korrigieren → update → Runde abschliessen.

        ⚠️ BEWUSST AUSSERHALB des form_tag oben: `button_to` erzeugt ein eigenes <form>, und
        verschachtelte Formulare sind ungueltiges HTML. Die beiden Knoepfe stehen deshalb optisch
        nebeneinander, gehoeren aber zu getrennten Formularen — "update" speichert die Felder,
        "Runde abschliessen" schaltet weiter.

        Seit 2026-09-23 steht derselbe Knopf zusaetzlich am Fuss von "Aktuelle Spiele"
        (Betreiber-Wunsch); die gemeinsame Fassung liegt in _advance_round_button. %>
    <%- if edit_games_modus %>
      <%= render partial: "tournament_monitors/advance_round_button",
            locals: { tournament_monitor: tournament_monitor } %>
    <%- end %>
  </div>
</div>
