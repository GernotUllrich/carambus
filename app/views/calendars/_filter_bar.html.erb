<%# Alle Filter als Links, damit jeder Zustand im URL steht und teilbar bleibt.
    ⚠️ Aktive Zustaende MUESSEN `btn` tragen: die projektweite Regel `a:not(.btn) { color: primary-600 }`
    (Spezifitaet 0,1,1) schlaegt sonst `text-white` (0,1,0) — der Text stand dann dunkelgruen auf
    dunkelgruenem Grund, also unsichtbar. `.btn` ist die vorgesehene Ausnahme; kein !important.
    Kein `.btn-dark` — bekannt kaputt (42-01, bewusst unrepariert).

    Region, Saison und Sparte stehen NICHT hier: die kommen aus dem globalen Scope-Band ueber
    der Seite. 42-01 hatte sie hier ein zweites Mal — genau die Doppelstruktur, die 42-02 aufloest.

    Die Leiste klebt oben: der Strom laedt beim Scrollen nach, der Seitenkopf waere sonst
    unerreichbar. Klassen ausgeschrieben — Tailwind erkennt nur literale Klassennamen. %>
<div class="flex flex-wrap items-center gap-2 mb-4 pb-3 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-20 bg-gray-200 dark:bg-gray-900 pt-3">

  <%# Rueckweg zum Scoreboard — nur auf einem Kiosk-Rechner (Bedingung und Ziel in
      `ApplicationHelper#scoreboard_return_path`, geteilt mit dem Menue in `_left_nav`).
      Fuer normale Besucher aendert sich nichts: dort ist der Helper nil.

      Steht in der KLEBENDEN Leiste, nicht im Seitenkopf: der Strom laedt beim Scrollen nach,
      ein Knopf im Kopf waere nach wenigen Kacheln unerreichbar. Am Touchdisplay war der
      Kalender sonst eine Sackgasse — der Weg ueber das ausklappbare Menue ist dort praktisch
      unauffindbar (Betreiber-Befund 2026-08-29).

      Bewusst groesser als die Filterknoepfe (text-sm, py-2 statt text-xs, py-1): er wird mit
      dem Finger getroffen, nicht mit der Maus.
      Klassen ausgeschrieben — Tailwind erkennt nur literale Klassennamen. %>
  <% if (scoreboard_back_path = scoreboard_return_path) %>
    <%= link_to scoreboard_back_path, data: {turbo: false},
          class: "btn btn-primary px-3 py-2 text-sm rounded-pill" do %>
      <span aria-hidden="true">←</span>
      <%= t("back_to_scoreboard") %>
    <% end %>
  <% end %>

  <%# Monatsnavigation %>
  <span class="inline-flex rounded-md border border-gray-300 dark:border-gray-600 overflow-hidden">
    <%= link_to "‹", calendar_url(month: (@month - 1.month).strftime("%Y-%m")),
          class: "btn btn-white px-2 py-1 text-sm rounded-none border-0",
          "aria-label": t("calendars.filter.prev_month") %>
    <%= link_to t("calendars.filter.today"), calendar_url(month: Date.current.strftime("%Y-%m")),
          class: "btn btn-white px-2 py-1 text-sm rounded-none border-x border-y-0" %>
    <%= link_to "›", calendar_url(month: (@month + 1.month).strftime("%Y-%m")),
          class: "btn btn-white px-2 py-1 text-sm rounded-none border-0",
          "aria-label": t("calendars.filter.next_month") %>
  </span>

  <%# Zurueck zur Anfangssicht: Einstiegsmonat, keine Achsen-Filter. Erscheint nur, wenn es
      etwas zurueckzusetzen gibt. Im Strom ist das der Weg zurueck an den Anfang, ohne sich
      durch die Monate hochzuklicken. %>
  <% if calendar_filters_active? %>
    <%= link_to t("calendars.filter.reset"), calendar_reset_path,
          class: "btn btn-white px-2 py-1 text-xs rounded-pill" %>
  <% end %>

  <%# Sparten-Selektor. Erscheint NUR, wenn die Sparten aus dem URL kommen — also wenn man vom
      Scoreboard kam (`?branch=Karambol,Kegel`). Auf der normalen Website fuehrt das Scope-Band
      die Sparte; ein zweiter Selektor daneben waere genau die Doppelstruktur, die 42-02
      aufgeloest hat.

      MEHRFACHauswahl, anders als die uebrigen Selektoren: die Sparte ist hier eine Menge (ein
      Karambol-Ort bringt „Karambol, Kegel" mit). Jede Option schaltet ihre Sparte an oder aus,
      „Alle Sparten" entfernt den Filter ganz — danach gilt wieder das Band.

      Der gewaehlte Wert steht im eingeklappten Knopf; damit bleibt die Einschraenkung sichtbar,
      obwohl das Scope-Band darueber weiter den Session-Wert zeigt. Ohne das waere es ein
      unsichtbarer Filter — der Zustand, den 42-02 beseitigt hat. %>
  <% if @url_branches.present? %>
    <%= render "filter_group",
          label: t("calendars.filter.branch"),
          selected: calendar_branch_summary,
          alle_text: t("calendars.filter.branch_all"),
          options: [[t("calendars.filter.branch_all"), calendar_url(branch: nil), @url_branches.blank?]] +
                   Branch.order(:name).map { |b|
                     [b.name, calendar_branch_toggle_url(b.name), @url_branches.include?(b)]
                   } %>
  <% end %>

  <%# Einzel/Mannschaft — die Achse, die Turniere von Liga-Spieltagen trennt. %>
  <span class="inline-flex rounded-full border border-gray-300 dark:border-gray-600 overflow-hidden">
    <%= link_to t("calendars.filter.kind_all"), calendar_url(kind: nil, group: nil),
          class: "btn #{@kind.nil? ? 'btn-primary' : 'btn-white'} px-3 py-1 text-xs rounded-none border-0" %>
    <%= link_to t("calendars.filter.kind_single"), calendar_url(kind: "single"),
          class: "btn #{@kind == 'single' ? 'btn-primary' : 'btn-white'} px-3 py-1 text-xs rounded-none border-0" %>
    <%# "Mannschaft" schliesst eine gewaehlte Gruppe aus — Spieltage tragen keine Kategorie. %>
    <%= link_to t("calendars.filter.kind_team"), calendar_url(kind: "team", group: nil),
          class: "btn #{@kind == 'team' ? 'btn-primary' : 'btn-white'} px-3 py-1 text-xs rounded-none border-0" %>
  </span>

  <%# Turniergruppe — nur wenn der Ausschnitt mehr als eine hergibt. %>
  <% if @group_options.size > 1 %>
    <%= render "filter_group",
          label: t("calendars.filter.group"),
          selected: @group.present? ? calendar_group_label(@group) : nil,
          alle_text: t("calendars.filter.group_all"),
          options: [[t("calendars.filter.group_all"), calendar_url(group: nil), @group.blank?]] +
                   @group_options.map { |v| [calendar_group_label(v), calendar_url(group: v), @group == v] } %>
  <% end %>

  <%# Disziplin — wirkt auf beide Arten, denn Turnier UND Liga fuehren je eine. %>
  <% if @discipline_options.size > 1 %>
    <%= render "filter_group",
          label: t("calendars.filter.discipline"),
          selected: @discipline_name,
          alle_text: t("calendars.filter.discipline_all"),
          options: [[t("calendars.filter.discipline_all"), calendar_url(discipline: nil), @discipline_name.blank?]] +
                   @discipline_options.map { |n| [n, calendar_url(discipline: n), @discipline_name == n] } %>
  <% end %>

  <%# Austragungsort. Gemessen (Saison 25/26): DBU 25 Turnier- und 110 Spieltag-Orte, BVNR 34/43
      — die Liste wird lang, deshalb eingeklappt. Wo es weniger als zwei Orte gibt (BLVSA),
      faellt der Selektor ganz weg. %>
  <% if @location_options.size > 1 %>
    <%= render "filter_group",
          label: t("calendars.filter.location"),
          selected: @location_name.present? ? calendar_location_label(@location_name) : nil,
          alle_text: t("calendars.filter.location_all"),
          options: [[t("calendars.filter.location_all"), calendar_url(location: nil), @location_name.blank?]] +
                   @location_options.map { |n| [calendar_location_label(n), calendar_url(location: n), @location_name == n] } %>
  <% end %>

  <%# DBU-Schalter: eine Ueberlagerung, keine Scope-Facette — die ueberregionale Ebene kommt
      ZUSAETZLICH zur Scope-Region dazu. Steht die Scope-Region schon auf DBU, ist er sinnlos. %>
  <% unless @region.shortname == "DBU" %>
    <span class="inline-flex rounded-full border border-gray-300 dark:border-gray-600 overflow-hidden ml-auto">
      <%= link_to t("calendars.filter.with_dbu"), calendar_url(dbu: nil),
            class: "btn #{@include_dbu ? 'btn-primary' : 'btn-white'} px-3 py-1 text-xs rounded-none border-0" %>
      <%= link_to t("calendars.filter.region_only", region: @region.shortname.presence || @region.name), calendar_url(dbu: "0"),
            class: "btn #{@include_dbu ? 'btn-white' : 'btn-primary'} px-3 py-1 text-xs rounded-none border-0" %>
    </span>
  <% end %>

  <%# Drucken: eigene Ansicht ueber die GANZE Saison, ohne Navigation. Neues Fenster, damit der
      Strom, in dem man gerade liest, stehen bleibt. %>
  <%= link_to t("calendars.filter.print"), calendar_url(print: "1"),
        target: "_blank", rel: "noopener",
        class: "btn btn-white px-2 py-1 text-xs rounded-pill" %>

</div>
