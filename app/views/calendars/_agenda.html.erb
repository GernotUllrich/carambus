<%# Entwurf B: nur Tage MIT Terminen. Turniere einzeln, Spieltage je Liga gruppiert —
    an einem Oktober-Samstag sind bis zu 13 Spieltage gemessen worden, einzeln aufgefuehrt
    verschwinden die Turniere darin. Aufklappbar per <details>, ohne JavaScript. %>
<div class="divide-y divide-gray-200 dark:divide-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
  <% entries.group_by(&:starts_on).sort.each do |tag, tages_eintraege| %>
    <div class="grid grid-cols-[5rem_1fr] sm:grid-cols-[7rem_1fr]">

      <div class="p-3 bg-gray-50 dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700">
        <div class="text-2xl font-semibold leading-none text-gray-900 dark:text-gray-100 tabular-nums">
          <%= tag.strftime("%d") %>
        </div>
        <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 mt-1">
          <%= l(tag, format: "%a · %b") %>
        </div>
      </div>

      <div class="p-3 flex flex-col gap-2">
        <% turniere, spieltage = tages_eintraege.partition(&:tournament?) %>

        <% turniere.each do |e| %>
          <div class="flex gap-3">
            <span class="w-1 rounded shrink-0 <%= calendar_branch_rail(e.branch_name) %>"></span>
            <div class="min-w-0">
              <div class="font-medium text-gray-900 dark:text-gray-100">
                <%= link_to e.title, tournament_path(e.record), class: "hover:underline" %>
                <% if e.dbu? %>
                  <span class="ml-1 align-middle text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded border border-dashed border-gray-400 text-gray-500 dark:text-gray-400">DBU</span>
                <% end %>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 flex flex-wrap gap-x-3">
                <% if e.time %><span class="tabular-nums"><%= e.time %></span><% end %>
                <% if e.subtitle %><span><%= e.subtitle %></span><% end %>
                <% if e.location_name %><span><%= e.location_name %></span><% end %>
                <% if e.multi_day? %><span><%= t("calendars.agenda.until", date: l(e.ends_on, format: "%d.%m.")) %></span><% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% spieltage.group_by(&:league_name).sort_by { |name, _| name.to_s }.each do |liga, gruppe| %>
          <details class="border border-gray-200 dark:border-gray-700 rounded">
            <summary class="cursor-pointer px-3 py-2 text-sm flex flex-wrap items-center gap-2">
              <span class="w-1 h-4 rounded shrink-0 <%= calendar_branch_rail(gruppe.first.branch_name) %>"></span>
              <span class="text-gray-800 dark:text-gray-200"><%= liga %></span>
              <span class="text-xs text-gray-500 dark:text-gray-400 ml-auto tabular-nums">
                <%= t("calendars.agenda.parties", count: gruppe.size) %>
              </span>
            </summary>
            <ul class="px-3 pb-2 pt-1 flex flex-col gap-1">
              <% gruppe.sort_by { |e| e.time.to_s }.each do |e| %>
                <li class="text-sm text-gray-700 dark:text-gray-300 flex flex-wrap gap-x-3">
                  <% if e.time %><span class="tabular-nums text-gray-500 dark:text-gray-400"><%= e.time %></span><% end %>
                  <span><%= link_to (e.subtitle.presence || t("calendars.agenda.party")), party_path(e.record), class: "hover:underline" %></span>
                  <% if e.location_name %><span class="text-xs text-gray-500 dark:text-gray-400"><%= e.location_name %></span><% end %>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
