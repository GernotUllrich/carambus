<%#
  K.-o.-Diagramm der Hauptrunde für regionale Turniere (aus den Ergebniszeilen/Games).
  Erwartet local: tournament. Rendert nichts, wenn keine K.-o.-Struktur erkennbar ist.
  Sieger = höheres Ergebnis; keine Videos (regionale Games haben keine).
%>
<% dko = regional_dko_bracket(tournament) %>
<% if dko.present? %>
  <%= render partial: "tournaments/dko_bracket_regional", locals: { tournament: tournament, dko: dko } %>
<% else %>
<% bracket = regional_ko_bracket(tournament) %>
<% if bracket.present? %>
  <div class="mt-8 pt-4 border-t border-primary-300" id="regional-ko-bracket-<%= tournament.id %>">
    <h3 class="text-lg font-semibold text-primary-800 dark:text-primary-200 mb-3">Hauptrunde (K.-o.)</h3>

    <%# --- Haupt-Baum --- %>
    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg shadow-inner overflow-x-auto p-4">
      <div class="flex flex-row gap-8 min-w-max">
        <% bracket[:tree].each do |round_label, round_games| %>
          <div class="flex flex-col justify-around gap-6 min-w-[15rem]">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 text-center mb-1">
              <%= round_label %>
            </h4>
            <% round_games.each_with_index do |game, idx| %>
              <%= render partial: "tournaments/ko_match", locals: { game: game, number: idx + 1, label: round_label } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# --- Extras: Platz 3 + Trostrunden --- %>
    <% if bracket[:extras].present? %>
      <div class="mt-6">
        <h4 class="text-sm font-semibold text-gray-600 dark:text-gray-300 mb-3">Platzierungs- und Trostrunden</h4>
        <div class="flex flex-row flex-wrap gap-8">
          <% bracket[:extras].each do |extra_label, extra_games| %>
            <div class="flex flex-col gap-3 min-w-[15rem]">
              <h5 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500"><%= extra_label %></h5>
              <% extra_games.each_with_index do |game, idx| %>
                <%= render partial: "tournaments/ko_match", locals: { game: game, number: idx + 1, label: extra_label } %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
<% end %>
