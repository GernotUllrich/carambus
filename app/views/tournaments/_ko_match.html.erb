<%#
  Eine K.-o.-Match-Zelle (regional). Locals: game, number, label.
  Zwei Teilnehmer (Heim/Gast), Sieger (höheres Ergebnis) hervorgehoben.
%>
<%
  parts = game.game_participations.to_a.sort_by { |p| p.role.to_s == "Heim" ? 0 : 1 }
  winner = ko_game_winner(game)
%>
<div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm overflow-hidden" data-game-id="<%= game.id %>">
  <div class="px-2 py-1 bg-gray-100 dark:bg-gray-700/60">
    <span class="text-[11px] font-semibold text-gray-500 dark:text-gray-400"><%= label %> · <%= number %></span>
  </div>
  <% parts.each_with_index do |gp, idx| %>
    <% is_winner = winner && gp.id == winner.id %>
    <div class="flex items-center gap-2 px-2 py-1.5 text-sm
                <%= "border-t border-gray-100 dark:border-gray-700" if idx > 0 %>
                <%= is_winner ? "bg-success-50 dark:bg-success-900/30 font-semibold text-gray-900 dark:text-gray-100" : "text-gray-700 dark:text-gray-300" %>">
      <span class="flex-1 truncate" title="<%= gp.player&.fullname %>">
        <%= gp.player&.fullname.presence || gp.player&.lastname.presence || "–" %>
      </span>
      <span class="font-mono tabular-nums text-gray-500 dark:text-gray-400"><%= gp.result %></span>
    </div>
  <% end %>
</div>
