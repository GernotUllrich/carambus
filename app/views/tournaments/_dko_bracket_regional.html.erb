<%#
  Echtes Doppel-K.-o.-Diagramm für regionale Turniere.
  Locals: tournament, dko (aus regional_dko_bracket).
  Gewinner-Baum (oben) + Verlierer-Baum (unten), zusammengeführt im Finale.
  Verbindungslinien zeichnet der Stimulus-Controller dko-bracket aus den echten
  Spielerfluss-Kanten (durchgezogen = weiter, gestrichelt = Abstieg in die Verliererrunde).
%>
<div class="mt-8 pt-4 border-t border-primary-300" id="regional-dko-bracket-<%= tournament.id %>"
     data-controller="dko-bracket player-highlight"
     data-dko-bracket-edges-value="<%= dko[:edges].to_json %>">
  <div class="flex items-center gap-3 mb-3">
    <h3 class="text-lg font-semibold text-primary-800 dark:text-primary-200">Doppel-K.-o.</h3>
    <div class="flex items-center gap-4 text-[11px] text-gray-500 dark:text-gray-400">
      <span class="inline-flex items-center gap-1">
        <svg class="w-6 h-2" viewBox="0 0 24 8"><line x1="0" y1="4" x2="24" y2="4" stroke="currentColor" stroke-width="1.5" /></svg>
        weiter
      </span>
      <span class="inline-flex items-center gap-1">
        <svg class="w-6 h-2 opacity-60" viewBox="0 0 24 8"><line x1="0" y1="4" x2="24" y2="4" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" /></svg>
        Abstieg
      </span>
    </div>
  </div>

  <div class="overflow-x-auto bg-gray-50 dark:bg-gray-900 rounded-lg shadow-inner p-4">
    <%# host: volle Inhaltsbreite; Linien und Bänder liegen darin übereinander bzw. gestapelt %>
    <div class="relative min-w-max text-gray-400 dark:text-gray-600" data-dko-bracket-target="host">
      <svg class="absolute inset-0 pointer-events-none z-0" data-dko-bracket-target="svg"
           xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true"></svg>

      <div class="relative z-10 flex flex-col gap-12">
        <%# ---- Gewinner-Baum + Finale ---- %>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-success-700 dark:text-success-400 mb-2">
            Gewinner-Baum
          </div>
          <div class="flex flex-row gap-14 items-start" data-band="wb">
            <% dko[:wb].each do |round_label, round_games| %>
              <%= render partial: "tournaments/dko_round", locals: { label: round_label, games: round_games } %>
            <% end %>
            <% if dko[:final].present? %>
              <div class="flex flex-col min-w-[14rem]" data-dko-col>
                <h4 class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-300 text-center mb-2">
                  Finale
                </h4>
                <div class="relative flex flex-col gap-4" data-dko-matches>
                  <%= render partial: "tournaments/ko_match", locals: { game: dko[:final], number: 1, label: "Finale" } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# ---- Verlierer-Baum ---- %>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-danger-700 dark:text-danger-400 mb-2">
            Verlierer-Baum
          </div>
          <div class="flex flex-row gap-14 items-start" data-band="lb">
            <% dko[:lb].each do |round_label, round_games| %>
              <%= render partial: "tournaments/dko_round", locals: { label: round_label, games: round_games } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
