<%= content_tag "div",
                "data-controller": "tournament",
                "data-tournament-id": @tournament.id,
                id: "tournament_#{@tournament.id}",
                class: "container mx-auto my-2 px-2" do %>
  <!-- Tournament Channel Subscription wird über JavaScript gehandhabt (tournament_channel.js) -->

  <!-- Tournament Details (collapsed in card) -->
  <div class="tournament-details-card">
    <%= render :partial => "show", locals: { tournament: @tournament, subtitle: "", show_edit_back: true } %>
  </div>

  <!-- Nur für Spielleiter auf lokalen Servern ohne ClubCloud-Ergebnisse -->
  <% if tournament_director?(current_user) && local_server? && !@tournament.has_clubcloud_results? %>
    <% if region_server_lsw_view?(@tournament) %>
      <%# Region Server (CC-los): kein Wizard — der ist Location-Server-Tournament-Management mit
          CC-Bias. Zwei Aktionen genügen (Betreiber-Entscheidung 2026-07-25). %>
      <%= render 'region_server_actions', tournament: @tournament %>
    <% else %>
      <%# Location Server / CC-Turniere: der volle Wizard (Modus/Start/Scoreboards). %>
      <%= render 'wizard_steps_v2', tournament: @tournament %>
    <% end %>
  <% end %>

  <!-- Tournament Status Overview - Für alle sichtbar wenn Turnier läuft/abgeschlossen -->
  <!-- Enthält jetzt auch die Setzliste mit Rankings -->
  <%= render 'tournament_status', tournament: @tournament %>

  <%# Regionales K.-o.-Diagramm der Hauptrunde (aus den Ergebniszeilen; unabhängig vom tournament_monitor) %>
  <%= render 'ko_bracket_regional', tournament: @tournament %>

  <%# ClubCloud-Meldeliste-Block: CC-behaftet (Titel, Wizard-Schritt-1-Verweis) → auf dem CC-losen
      Region Server ausgeblendet. Die aktuelle Meldeliste sieht der LSW ohnehin in der Setzliste/Rangliste. %>
  <% if !@tournament.has_clubcloud_results? && !region_server_lsw_view?(@tournament) %>
    <div class="seedings-table-container">
      <h2>
        <%= t("tournaments.show.clubcloud_registration_list.title") %>
        (<%= @clubcloud_seedings.count %>)
      </h2>
      <p class="text-gray-600 text-sm mb-4 dark:text-gray-300">
        <%= t("tournaments.show.clubcloud_registration_list.description") %>
      </p>
      <% if @tournament.source_url.present? %>
        <p class="text-sm mb-4">
          <%= link_to t("tournaments.show.clubcloud_registration_list.link_label"),
              @tournament.source_url,
              target: "_blank",
              rel: "noopener",
              class: "inline-flex items-center gap-1 text-primary-700 hover:text-primary-900 dark:text-primary-300 dark:hover:text-primary-100" %>
        </p>
      <% end %>

      <% if @clubcloud_seedings.any? %>
        <div class="bg-white/90 rounded shadow overflow-hidden ring-1 ring-slate-200 dark:bg-slate-900/90 dark:ring-slate-800">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-100/80 border-b border-slate-200 text-slate-500 dark:bg-slate-800 dark:border-slate-700 dark:text-slate-400">
              <tr>
                <th class="p-3 text-left font-semibold"><%= t("tournaments.show.clubcloud_registration_list.table.order") %></th>
                <th class="p-3 text-left font-semibold"><%= t("tournaments.show.clubcloud_registration_list.table.name") %></th>
                <th class="p-3 text-left font-semibold"><%= t("tournaments.show.clubcloud_registration_list.table.club") %></th>
              </tr>
            </thead>
            <tbody>
              <% @clubcloud_seedings.each do |seeding| %>
                <% player = seeding.player %>
                <tr class="border-b border-slate-200 bg-white/80 odd:bg-gray-50 dark:border-slate-700 dark:bg-slate-950/60 dark:odd:bg-slate-900/70">
                  <td class="p-3 text-sm font-medium text-slate-900 dark:text-slate-200"><%= seeding.position.presence || "—" %></td>
                  <td class="p-3 text-sm text-slate-900 dark:text-slate-200"><%= player&.fullname.presence || t("tournaments.show.clubcloud_registration_list.unknown_player") %></td>
                  <td class="p-3 text-sm text-slate-900 dark:text-slate-200"><%= player&.club&.shortname.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="bg-yellow-50 border border-yellow-200 rounded p-4 dark:bg-yellow-900/20 dark:border-yellow-500/70">
          <p class="text-sm text-yellow-800 dark:text-yellow-100">
            <%= t("tournaments.show.clubcloud_registration_list.empty") %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Plan 32-03: effective_seedings (lokale bevorzugen, sonst ClubCloud) statt dupliziertem has_local-Idiom %>

  <!-- Rankings Section -->
  <div class="seedings-table-container">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3 mt-6"><%= I18n.t("tournaments.show.rankings") %></h2>
      <div class="flex flex-col gap-6 bg-surface-card dark:bg-gray-800 rounded-card border border-gray-200 dark:border-gray-700 p-4 overflow-x-auto">
        <%# Plan 41-02: left_joins statt joins. Diese Zeile sammelt die LISTENNAMEN; ein INNER %>
        <%# JOIN auf players liess Seedings ohne player_id nicht beitragen. Solange mindestens %>
        <%# ein Seeding mit Player dieselbe Liste traegt, fiel das nicht auf — die Zeilen %>
        <%# darunter rendern ohne Join. Ist aber KEINE Spielerin aufloesbar (internationales %>
        <%# Feld ohne dbu_nr, genau der Fall des Ergebnisarchivs), wurde die Liste nie %>
        <%# gesammelt und die Tabelle blieb komplett leer. %>
        <%# Die Sortierung bleibt: sie haelt die Reihenfolge mehrerer Listen stabil. Zeilen %>
        <%# ohne Player sortiert Postgres bei ASC ans Ende — die Tabellenzeilen selbst werden %>
        <%# ohnehin nach Rank sortiert (s. unten), nicht nach Spielernamen. %>
        <%- lists = @tournament.effective_seedings.left_joins(:player).order("players.lastname, players.firstname").map { |s| s.data["result"].keys rescue [] }.inject([]) { |a, memo| memo |= a; memo } %>
        <%- lists.each do |list| %>
          <div class="flex flex-col">
            <h3><%= list %></h3>
            <%# Spalten in Originalreihenfolge; Zeilen wie bisher nach Rank/Rang sortiert (unverändertes %>
            <%# Verhalten). HINWEIS: das gescrapte Rank-Feld ist bei alten Turnieren teils historisch %>
            <%# unzuverlässig (Daten-/Sync-Thema, carambus_api) — daher NICHT prominent nach vorne gezogen. %>
            <table class="flex-1">
              <thead>
              <tr>
                <%- @tournament.effective_seedings.select { |seeding| seeding.data["result"].andand[list].present? }.first.data["result"][list].keys.each do |k| %>
                  <th class="text-left text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 p-2 whitespace-nowrap"><%= k %></th>
                <%- end %>
              </tr>
              </thead>
              <tbody>
              <%- @tournament.effective_seedings.select do |seeding|
                seeding.data["result"].andand[list].present?
              end.sort_by do |seeding|
                if seeding.data["result"][list]["Rank"].present?
                  seeding.data["result"][list]["Rank"].to_i
                elsif seeding.data["result"][list]["Rang"].present?
                  seeding.data["result"][list]["Rang"].to_i
                end
              end.each do |seeding| %>
                <tr>
                  <%- seeding.data["result"][list].each do |k, v| %>
                    <td class="p-2 text-sm text-gray-900 dark:text-gray-100 border-t border-gray-100 dark:border-gray-700"><%= v %></td>
                  <%- end %>
                </tr>
              <%- end %>
              </tbody>
            </table>
          </div>
        <%- end %>
      </div>
  </div>

  <!-- Games Section -->
  <%# Plan 32-03: has_local_seedings? entscheidet lokale vs. globale Games (Game-Scope bleibt games.id-basiert) %>
  <%# Plan 41-02: Archiv-Zeilen (ArchivedGame) und Live-Games duerfen NICHT gemischt werden — %>
  <%# die Spaltenkoepfe stammen aus data.keys des ERSTEN Records, und Live-Games tragen dort %>
  <%# TableMonitor-State (playera, innings_list), Archiv-Zeilen die Fachspalten der App. %>
  <%# Sobald ein Archiv existiert, zeigt die Seite dieses: nach dem Turnier will man den %>
  <%# Endstand sehen, nicht den Monitor-Zustand. Ohne Archiv bleibt alles wie bisher. %>
  <%- has_archive = @tournament.games.where(type: "ArchivedGame").exists? %>
  <%- game_scope = if has_archive
        "games.type = 'ArchivedGame'"
      elsif @tournament.has_local_seedings?
        "games.id >= #{Game::MIN_ID} AND (games.type IS NULL OR games.type != 'ArchivedGame')"
      else
        "games.id < #{Game::MIN_ID}"
      end %>
  <div class="seedings-table-container">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3 mt-6"><%= I18n.t("tournaments.show.games") %></h2>
      <div class="bg-surface-card dark:bg-gray-800 rounded-card border border-gray-200 dark:border-gray-700 p-4 overflow-x-auto">
        <%- if @tournament.games.where(game_scope).present? %>
          <table class="flex-1">
            <thead>
            <tr>
              <%- @tournament.games.where(game_scope).first.data.keys.each do |k| %>
                <th class="text-left text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500 p-2 whitespace-nowrap"><%= k %></th>
              <%- end %>
            </tr>
            </thead>
            <tbody>
            <%- @tournament.games.where(game_scope).sort_by do |game|
              game.data["Partie"].to_i
            end.each do |game| %>
              <tr>
                <%- next unless (game.data["Ergebnis"].present? || game.data["Punkte"].present?) %>
                <%- skip = false %>
                <%- game.data.each do |k, v| %>
                  <%- skip = true if %w{Heim Gast}.include?(k) && v.blank? %>
                  <%- unless skip %>
                    <td class="p-2 text-sm text-gray-900 dark:text-gray-100 border-t border-gray-100 dark:border-gray-700"><%= v %></td>
                  <%- end %>
                <%- end %>
              </tr>
            <%- end %>
            </tbody>
          </table>
        <%- end %>
      </div>
  </div>

  <!-- Admin Actions (TableMonitor-Reset, Force-Reset, Sysadmin-Reload) — Tournament-Management,
       gehört auf den Location Server; auf dem CC-losen Region Server ausgeblendet. Die Meldeliste-
       Pflege liegt im Zwei-Link-Panel oben. -->
  <% if local_server? && !region_server_lsw_view?(@tournament) %>
    <div class="admin-actions-container flex flex-wrap items-center gap-2 mt-8">
      <%- games = @tournament.games.where(game_scope).order(seqno: :asc) %>

      <!-- Regular Admin Actions (only for tournaments without ClubCloud results) -->
      <% if !@tournament.has_clubcloud_results? %>
        <!-- Direct link to participants/seedings management (always visible) -->
        <%= link_to t('tournaments.show.edit_participants_button'),
            define_participants_tournament_path(@tournament),
            class: 'btn btn-flat btn-secondary',
            style: 'float: left; margin-right: 10px;',
            title: t('tournaments.show.edit_participants_title') %>
        
        <%# UI-06 (plan 36B-05): trigger buttons must live inside the shared %>
        <%# confirmation-modal Stimulus scope so click actions can dispatch. %>
        <%= render "shared/confirmation_modal" do %>
          <%- if !@tournament.tournament_started %>
            <%= form_tag reset_tournament_path(@tournament),
                         method: :post,
                         id: "reset-tournament-form-#{@tournament.id}",
                         style: "display: inline;" do %>
            <% end %>
            <%
              reset_state_line = I18n.t("tournaments.show.reset_tournament_modal.state_line")
              reset_games_line = I18n.t("tournaments.show.reset_tournament_modal.games_line")
              reset_games_count = @tournament.games.where.not(ended_at: nil).count
              reset_body = I18n.t("tournaments.show.reset_tournament_modal.body") +
                           "\n\n" + reset_state_line + " " + @tournament.state.to_s +
                           "\n" + reset_games_line + " " + reset_games_count.to_s
            %>
            <button type="button"
                    class="btn btn-flat btn-primary"
                    style="float: left; margin-right: 10px;"
                    data-action="click->confirmation-modal#open"
                    data-confirmation-modal-form-id-param="reset-tournament-form-<%= @tournament.id %>"
                    data-confirmation-modal-title-param="<%= I18n.t('tournaments.show.reset_tournament_modal.title') %>"
                    data-confirmation-modal-body-param="<%= reset_body %>"
                    data-confirmation-modal-confirm-label-param="<%= I18n.t('tournaments.show.reset_tournament_modal.confirm') %>">
              <%= I18n.t("tournaments.show.reset_tournament_monitor") %>
            </button>
          <%- end %>
          <%- if (User::PRIVILEGED + [User.scoreboard.andand.email.andand.downcase]).include? current_user&.email&.downcase %>
            <%= form_tag reset_tournament_path(@tournament, force_reset: true),
                         method: :post,
                         id: "force-reset-tournament-form-#{@tournament.id}",
                         style: "display: inline;" do %>
            <% end %>
            <%
              force_state_line = I18n.t("tournaments.show.reset_tournament_modal.state_line")
              force_games_line = I18n.t("tournaments.show.reset_tournament_modal.games_line")
              force_games_count = @tournament.games.where.not(ended_at: nil).count
              force_body = I18n.t("tournaments.show.force_reset_tournament_modal.body") +
                           "\n\n" + force_state_line + " " + @tournament.state.to_s +
                           "\n" + force_games_line + " " + force_games_count.to_s
            %>
            <button type="button"
                    class="btn btn-flat btn-primary"
                    style="float: left; margin-right: 10px;"
                    data-action="click->confirmation-modal#open"
                    data-confirmation-modal-form-id-param="force-reset-tournament-form-<%= @tournament.id %>"
                    data-confirmation-modal-title-param="<%= I18n.t('tournaments.show.force_reset_tournament_modal.title') %>"
                    data-confirmation-modal-body-param="<%= force_body %>"
                    data-confirmation-modal-confirm-label-param="<%= I18n.t('tournaments.show.force_reset_tournament_modal.confirm') %>">
              <%= I18n.t("tournaments.show.debugging_force_reset_tournament_monitor") %>
            </button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# CC-loser On-demand-Reload (Plan 29-06 AC-5): der managende Local Server holt die frische
      Meldeliste von der Authority. Nur bei CC-losem Turnier (kein tournament_cc), das über den
      Region-Server-Ingest entstanden ist (source_url gesetzt). Analog dem CC-Reload, ohne ClubCloud. %>
  <% if local_server? && !@tournament.cc_sourced? && @tournament.source_url.present? %>
    <%= button_to t("tournaments.reload_entry_list.button", default: "Meldeliste neu laden"),
                  reload_entry_list_tournament_path(@tournament),
                  method: :post,
                  class: "btn btn-flat btn-primary",
                  style: "float: left; margin-right: 10px;" %>
  <% end %>

  <!-- Sysadmin: Force Reload from API Server (for closed tournaments with results) -->
  <!-- if on API Server force full scraping again -->
  <% if current_user&.privileged_access? %>
    <%= button_to I18n.t("tournaments.show.force_reload_from_api"),
                  reload_from_cc_tournament_path(@tournament, reload_games: true),
                  method: :post,
                  class: "btn btn-flat btn-warning",
                  data: { confirm: I18n.t("tournaments.show.force_reload_confirm") },
                  style: "float: left; margin-right: 10px;" %>
  <% end %>
<% end %>
