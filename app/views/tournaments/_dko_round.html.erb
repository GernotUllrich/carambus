<%#
  Eine Runden-Spalte im Doppel-K.-o.-Diagramm. Locals: label, games.
  Überschrift fest oben; die Matches liegen im positionierbaren Container, den der
  dko-bracket-Controller vertikal zentriert (Mittelwert der Speiser-Y). Ohne JS
  stapeln sie schlicht untereinander (Fallback).
%>
<div class="flex flex-col min-w-[14rem]" data-dko-col>
  <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 text-center mb-2">
    <%= label %>
  </h4>
  <div class="relative flex flex-col gap-4" data-dko-matches>
    <% games.each_with_index do |game, idx| %>
      <%= render partial: "tournaments/ko_match", locals: { game: game, number: idx + 1, label: label } %>
    <% end %>
  </div>
</div>
