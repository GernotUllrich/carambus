<%# Quick Game Setup - NO Alpine.js, ultra-fast for Pi 3 %>
<%# Player Panel + TableKind-specific Quick Buttons %>

<%# Plan 02-02: serverseitig vorberechnete Ranglisten je Parameterkombination und die
    Namen dazu. Eingebettet statt nachgeladen — die Seite laeuft auf einem Raspi und
    soll beim Oeffnen des Modals keinen Roundtrip machen.
    to_json escapet HTML-Entities (Rails-Default), der Inhalt ist damit script-sicher. %>
<%# Betreiber-Entscheidung 2026-08-29: Sortierung nach VORNAME, Darstellung
    "Vorname Nachname". Genau das ist `fl_name` (player.rb:64), und die Queries in
    locations_controller sortieren bereits danach — vorher zeigte die View `fullname`
    ("Nachname, Vorname") an, was der Sortierung widersprach. %>
<%- recent_player_names = (Array(guest_players_default) + Array(guest_players_other) + Array(club_players))
      .index_by(&:id).transform_values(&:fl_name) %>
<script type="text/javascript">
  window.recentPlayersByPreset = <%= (local_assigns[:recent_players] || {}).to_json.html_safe %>;
  window.playerNamesById = <%= recent_player_names.to_json.html_safe %>;

  // Plan 02-02 (Checkpoint-Fassung): die Paarung als Liste von hoechstens zwei IDs.
  // Kein A/B mehr in der Bedienung — welcher Spieler intern playera wird, entscheidet
  // allein die Reihenfolge der Griffe und ist fachlich bedeutungslos (das Ausstossen
  // bestimmt, wer beginnt).
  window.selectedPlayers = [];

  // Ein Name wurde angetippt.
  //   0 gewaehlt  -> Platz 1
  //   1 gewaehlt  -> derselbe Name hebt die Wahl auf, ein anderer fuellt Platz 2
  //   2 gewaehlt  -> Paarung verwerfen, der neue Name steht allein auf Platz 1
  //                  (Betreiber-Entscheidung 2026-08-29)
  function pick_player(playerId) {
    var sel = window.selectedPlayers;
    if (sel.length >= 2) {
      window.selectedPlayers = [playerId];
    } else if (sel.indexOf(playerId) !== -1) {
      window.selectedPlayers = sel.filter(function (id) { return id !== playerId; });
    } else {
      sel.push(playerId);
    }
    render_pairing();
  }

  // Tipp auf einen belegten Platz gibt genau diesen frei; der andere bleibt stehen.
  function clear_pairing_slot(index) {
    var sel = window.selectedPlayers;
    if (!sel[index]) { return; }
    sel.splice(index, 1);
    render_pairing();
  }

  // Zeichnet Paarungszeile, Markierung in der Liste und den Zustand des Startknopfes.
  function render_pairing() {
    var sel = window.selectedPlayers;
    var names = window.playerNamesById || {};

    for (var i = 0; i < 2; i++) {
      var slot = document.getElementById("pairing_slot_" + i);
      if (!slot) { continue; }
      var id = sel[i];
      slot.textContent = id ? (names[id] || id) : "…";
      slot.classList.toggle("opacity-60", !id);
      slot.classList.toggle("border-dashed", !id);
    }

    document.querySelectorAll(".player-choice").forEach(function (btn) {
      var chosen = sel.indexOf(parseInt(btn.dataset.playerId, 10)) !== -1;
      btn.classList.toggle("ring-4", chosen);
      btn.classList.toggle("ring-green-500", chosen);
    });

    // Die versteckten Felder tragen die Auswahl zum Formular des beruehrten Knopfes.
    document.getElementById("player_a_id").value = sel[0] || "";
    document.getElementById("player_b_id").value = sel[1] || "";

    var startBtn = document.getElementById("start_selected_game");
    if (startBtn) {
      var ready = sel.length === 2;
      startBtn.classList.toggle("opacity-40", !ready);
      startBtn.classList.toggle("pointer-events-none", !ready);
    }
  }

  function set_players_modal() {
    document.getElementById("modal-players").classList.toggle("hidden");
    document.getElementById("modal-players-bg").classList.toggle("hidden");
    document.getElementById("modal-players").classList.toggle("flex");
    document.getElementById("modal-players-bg").classList.toggle("flex");
  }

  // Plan 02-02: Aufruf aus _quick_game_buttons, nachdem window.pendingQuickGame
  // gesetzt wurde. Setzt die Paarung zurueck, fuellt die Kopfgruppe passend zu den
  // Parametern des beruehrten Knopfes und oeffnet dann die Auswahl.
  function open_players_modal_for_game() {
    window.selectedPlayers = [];
    render_recent_players();
    render_pairing();
    set_players_modal();
  }

  // Baut die Kopfgruppe aus den serverseitig vorberechneten Ranglisten.
  // Ohne passende Historie bleibt der Container versteckt — keine leere Ueberschrift,
  // kein Abstand. Die Eintraege verhalten sich wie die der Vollliste: ein Tipp waehlt,
  // es gibt kein A und kein B.
  function render_recent_players() {
    var box = document.getElementById("recent-players");
    if (!box) { return; }
    box.innerHTML = "";
    box.classList.add("hidden");

    var pending = window.pendingQuickGame;
    if (!pending) { return; }

    var ids = (window.recentPlayersByPreset || {})[pending.rankingKey] || [];
    if (!ids.length) { return; }

    // Betreiber-Entscheidung 2026-08-29: auch die Kopfgruppe alphabetisch.
    // Der Ranking-Nutzen steckt in der AUSWAHL dieser sechs, nicht in ihrer
    // Reihenfolge — sortiert findet man den gesuchten Namen schneller.
    var entries = ids.map(function (id) {
      return { id: id, name: (window.playerNamesById || {})[id] };
    }).filter(function (e) { return !!e.name; });
    // Dieselbe Titel-Regel wie die SQL-Sortierung der Vollliste (Player.sort_key_sql),
    // damit Kopfgruppe und Liste nicht unterschiedlich sortieren.
    var titleRe = new RegExp("<%= j Player::SORT_TITLE_PATTERN %>", "i");
    entries.sort(function (a, b) {
      return a.name.replace(titleRe, "").localeCompare(b.name.replace(titleRe, ""), "de");
    });

    var html = '<div class="text-2vw mb-2 opacity-80"><%= j t("location.free_game.recent_players") %></div>' +
               '<div class="flex flex-wrap gap-2">';
    entries.forEach(function (e) {
      html += '<button type="button" class="player-choice px-3 py-2 border-2 rounded-lg text-1-5vw" ' +
              'data-player-id="' + e.id + '" onclick="pick_player(' + e.id + ')">' + e.name + '</button>';
    });
    html += "</div>";
    box.innerHTML = html;
    box.classList.remove("hidden");
  }

  // Schickt das Formular des zuvor beruehrten Spiel-Knopfes ab — mit den beiden hier
  // gewaehlten Spielern. Die Reihenfolge der Griffe bestimmt, wer intern playera wird;
  // fachlich ist das ohne Bedeutung, weil das Ausstossen den Anfang entscheidet.
  function start_selected_game() {
    var pending = window.pendingQuickGame;
    var sel = window.selectedPlayers || [];
    if (!pending || sel.length !== 2) { return; }

    var fieldA = document.getElementById(pending.formId);
    var fieldB = document.getElementById(pending.formId.replace("player_a", "player_b"));
    if (!fieldA || !fieldB) { return; }

    fieldA.value = sel[0];
    fieldB.value = sel[1];
    fieldA.form.submit();
  }
</script>

<%# Player Selection Modal %>
<div style="z-index:900" class="hidden opacity-70 fixed inset-0 bg-black" id="modal-players-bg"></div>
<div style="z-index:910" class="hidden overflow-x-hidden overflow-y-auto fixed inset-0 outline-none focus:outline-none justify-center" id="modal-players">
  <div class="border-2 border-gray-500 rounded-lg shadow-lg relative flex flex-col w-5/6 dark:text-gray-200 bg-white dark:bg-black outline-none focus:outline-none">
    <div class="flex flex-col">
      <div class="flex justify-around pt-5 space-x-10">
        <%= custom_link_to t('cancel'), "javascript:set_players_modal()", data: { turbolinks: false }, class: "focus:outline-none focus:ring-8 focus:ring-gray-500 focus:ring-opacity-90 border-0 btn btn-secondary text-2vw", id: "cancel", tabindex: "2" %>
        <%# Plan 02-02: aus dem frueheren "weiter" wird der eigentliche Spielstart —
            die Parameter stehen seit dem Knopfdruck fest, hier fehlen nur die Spieler. %>
        <%= custom_link_to t('location.free_game.start_game'), "javascript:start_selected_game()", data: { turbolinks: false }, class: "focus:outline-none focus:ring-8 focus:ring-green-500 focus:ring-opacity-90 border-0 btn btn-primary text-2vw", id: "start_selected_game", tabindex: "1" %>
      </div>

      <%# Plan 02-02 (Checkpoint-Fassung): Paarungszeile als Rueckmeldung.
          Die A/B-Zuordnung ist bei der Auswahl bedeutungslos — die Reihenfolge
          entscheidet ohnehin das Ausstossen. Statt zwei Spalten fuer A und B gibt es
          daher EINE Liste; hier oben baut sich die Paarung sichtbar auf.
          Ein Tipp auf einen belegten Platz gibt ihn zur Neuwahl frei. %>
      <div class="flex items-center justify-center gap-4 px-6 pt-4 pb-2 text-3vw">
        <button type="button" id="pairing_slot_0" onclick="clear_pairing_slot(0)"
                class="min-w-[12rem] px-4 py-3 border-2 border-dashed rounded-lg opacity-60"></button>
        <span class="opacity-70">vs.</span>
        <button type="button" id="pairing_slot_1" onclick="clear_pairing_slot(1)"
                class="min-w-[12rem] px-4 py-3 border-2 border-dashed rounded-lg opacity-60"></button>
      </div>

      <%# Kopfgruppe "Zuletzt" — beim Oeffnen aus dem Ranking des beruehrten Knopfes
          gefuellt. Bleibt unsichtbar, solange es keine passende Trainingshistorie gibt. %>
      <div id="recent-players" class="hidden px-6 pt-2"></div>

      <%- player_entries = [
        ["guests", Array(guest_players_default) + Array(guest_players_other)],
        ["club", Array(club_players)]
      ] %>

      <div class="px-6 pb-6">
        <%- player_entries.each do |group_key, members| %>
          <%- next if members.blank? %>
          <div class="mt-3 text-1-5vw opacity-70"><%= group_key == "guests" ? "Gäste" : "Club" %></div>
          <div class="flex flex-wrap gap-2 mt-1" data-player-pager>
            <%- members.each do |p| %>
              <button type="button"
                      class="player-choice px-3 py-2 border-2 rounded-lg text-1-5vw"
                      id="player_choice_<%= p.id %>"
                      data-player-id="<%= p.id %>"
                      onclick="pick_player(<%= p.id %>)">
                <%= p.fl_name %>
              </button>
            <%- end %>
          </div>
        <%- end %>
      </div>
    </div>
  </div>
</div>

<%# Main Page %>
<div class="p-4 w-full m-auto flex items-center flex-col bg-cover min-h-screen bg-center bg-no-repeat" 
     style="background-image: url('<%= @location.background_image.gsub(".", "-.") %>')">
  
  <h1 style="text-shadow: 2px 2px #000000" class="text-5vw flex text-gray-300 mb-4">
    <%= "#{table.andand.table_kind.andand.name} - #{table.andand.name}" %>
  </h1>
  
  <h2 style="text-shadow: 2px 2px #000000" class="text-3vw flex text-gray-300 mb-6">
    Schnellstart - Freies Spiel
  </h2>

  <%# Plan 02-02: Traeger fuer die im Modal gewaehlten Spieler. KEINE Vorbelegung mehr
      (frueher Gast A/Gast B): die Paarungszeile im Modal soll leer beginnen und sich
      sichtbar aufbauen. Der Schutz vor Fehlverbuchung ist dadurch sogar staerker —
      ohne zwei bewusste Griffe laesst sich gar nicht starten.
      Der frueher hier stehende Knopf "Spieler auswählen" und die Anzeige der Paarung
      sind entfallen: die Auswahl gehoert jetzt zum Spielstart, ein zweiter Einstieg
      ins selbe Modal mit anderer Wirkung waere verwirrend. %>
  <input type="hidden" id="player_a_id" name="player_a_id" value="" />
  <input type="hidden" id="player_b_id" name="player_b_id" value="" />

  <%# Quick Game Buttons (TableKind-specific) %>
  <%= render 'quick_game_buttons', 
      table_kind_name: table.table_kind.name, 
      table_monitor: table_monitor,
      location: @location %>

  <%# Back Link %>
  <div class="flex justify-center mt-8">
    <%= link_to "← Zurück", 
        location_path(@location.md5, sb_state: "start", :"data-turbo" => false),
        class: "text-white text-xl underline hover:text-primary-300",
        data: { turbo: false } %>
  </div>
</div>

<%# Blaetterknoepfe fuer die Spielerliste — siehe docs/ui-conventions.md, Abschnitt 6. %>
<%= render "player_pager" %>
