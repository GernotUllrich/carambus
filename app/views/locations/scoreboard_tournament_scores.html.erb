<!--suppress RubyScope, RubyScope, RubyScope -->
<style>
    .responsive-svg {
        width: 100%;
        height: auto;
    }
</style>
<div class="w-1/12 grid grid-cols-2 gap-4 mr-4 fixed text-gray-300 hover:text-black text-2vw font-bold" style="right: 10px; top: -10px;">
  <%= custom_link_to toggle_dark_mode_location_path(@location), :"data-turbo" => false do %>
    <%= render_svg "icons/adjust", styles: "responsive-svg fill-current icon-lg m-4 text-white inline-block", title: "toggle dark mode" %>
  <% end %>
  <%= custom_link_to scoreboard_location_path(@location.md5, sb_state: "welcome", :"data-turbo" => false) do %>
    <%= render_svg "icons/home", styles: "responsive-svg fill-current icon-lg m-4 text-white inline-block", title: "home" %>
  <% end %>
</div>

<div class="p-14 w-full m-auto flex flex-col bg-cover h-screen bg-center bg-no-repeat">
  <%- if @location.tournaments.present? %>
    <%- @tournaments = @tournament.present? ? [@tournament] : @location.tournaments.joins(:tournament_monitor).order("tournament_monitors.updated_at desc").to_a %>

    <%- @tournaments.each do |tournament| %>
      <!--      <h1 style="text-shadow: 2px 2px #000000" class="flex text-yellow-400 m-5 mb-10 text-center text-3vw"><%#= tournament.title.gsub("Biathlonl", "Biathlon") %></h1>-->
      <%- if tournament&.tournament_monitor&.present? %>
        <%- tournament_monitor = tournament.tournament_monitor %>
        <%# Eine Relation fuer Zaehlung UND Ausgabe: nur Tische mit laufendem Spiel. Vorher
            # zaehlte die Zeile darueber alle gebundenen TableMonitors, waehrend die Schleife
            # nur die mit joins(:game) ausgab (23. DBU Grand Prix, 17.10.2026 — vier gebundene
            # Tische bei zwei Halbfinals ergaben vier Spalten mit zwei winzigen Kacheln).
            # Begruendung der Spaltenrechnung samt Untergrenze: TournamentMonitorsHelper.
            # includes(:table) gegen das N+1 beim Sortieren. %>
        <%- active_monitors = tournament_monitor.table_monitors.joins(:game).includes(:table)
                                                .to_a.sort_by { |tm| tm.table.name }.reverse %>
        <%- cols = teaser_grid_cols(active_count: active_monitors.count,
                                    bound_count: tournament_monitor.table_monitors.count) %>
        <turbo-frame id="teasers" class="grid grid-cols-<%= cols %> text-<%= cols < 4 ? "3" : "2" %>vw gap-8">
          <%- active_monitors.each do |table_monitor| %>
            <%- table_monitor.get_options!(I18n.locale) %>
            <turbo_frame id="teaser_<%= table_monitor.id %>">
              <%= render partial: "table_monitors/teaser", locals: { table_monitor: table_monitor } %>
            </turbo_frame>
          <%- end %>
        </turbo-frame>
      <%- end %>
    <%- end %>
  <%- end %>
</div>
