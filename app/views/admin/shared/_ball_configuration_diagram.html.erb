<%#
  Ball-Konfigurations-Diagramm (SVG, interaktiv zoombar im Browser).

  Zweck: Koordinaten-Validierung für die v0.9-Ontologie. Menschen
  können x/y-Werte nicht im Kopf gegen ein Diagramm mappen.

  Locals:
    ball_configuration  — BallConfiguration-Instance (required)
    title               — Optionaler Überschrift-String
    subtitle            — Optionaler Untertitel (z.B. "Start" / "Ende")

  Konvention:
    x ∈ [0, 1] = normalisierte Länge (lange Tisch-Achse)
    y ∈ [0, 1] = normalisierte Breite
    Der Tisch wird landscape gezeichnet: Länge horizontal.

  Seitenverhältnis: alle Carambol-Tische ~2:1 (Länge:Breite).
  Tatsächliche Werte:
    klein     = 2.10 × 1.05 m  (belgisch)
    halbmatch = 2.30 × 1.15 m  (Approximation)
    match     = 2.84 × 1.42 m  (französisch)

  Farben (Hex→Token-Migration 2026-09-03): Chrome (Panel, Text, Badges) nutzt
  die App-Token mit Dark-Mode. Die SVG-Malfarben sind dagegen PHYSISCHE
  Objektfarben (Tuch, Bande, Bälle nach Regelwerk) und liegen als
  `billiard.*`-Token in tailwind.config.js — sie schlagen im Dark Mode
  bewusst NICHT um: ein gelber Ball bleibt gelb.
%>

<% bc = local_assigns[:ball_configuration] %>
<% return unless bc %>

<% title = local_assigns[:title] %>
<% subtitle = local_assigns[:subtitle] %>

<% table_dimensions = {
     "klein"     => { length_cm: 210, width_cm: 105 },
     "halbmatch" => { length_cm: 230, width_cm: 115 },
     "match"     => { length_cm: 284, width_cm: 142 }
   } %>
<% dims = table_dimensions[bc.table_variant] || table_dimensions["match"] %>

<%# SVG-Geometrie. Seitenverhältnis table_w : table_h = 2 : 1 (Carambol-
    Standard). padding = Rahmen um den Tisch herum (für Banden-Dicke). %>
<% svg_width   = 900 %>
<% svg_height  = 470 %>
<% padding     = 20 %>
<% table_w     = svg_width  - 2 * padding %>
<% table_h     = svg_height - 2 * padding %>

<%# Ball-Durchmesser physikalisch korrekt: Karambol-Kugel 6 cm Durchmesser,
    also 3 cm Radius. SVG-Radius skaliert mit der tatsaechlichen Tisch-
    Länge (dims[:length_cm]), damit ein Ball auf klein groesser aussieht
    als auf match (weil klein kompakter ist pro Pixel).
    Match (284 cm)     → ca.  9 px Radius
    Halbmatch (230 cm) → ca. 11 px Radius
    Klein (210 cm)     → ca. 12 px Radius %>
<% ball_radius_cm = 3.0 %>
<% ball_radius    = ball_radius_cm * table_w / dims[:length_cm] %>
<% label_font_size = (ball_radius * 0.9).round %>

<%#
  Koordinaten-Mapping:
    normal [0,1] auf x → [padding, padding + table_w]
    normal [0,1] auf y → [padding, padding + table_h]
%>
<% to_svg_x = ->(nx) { padding + nx * table_w } %>
<% to_svg_y = ->(ny) { padding + ny * table_h } %>

<%# Ball-Farbklassen als VOLLSTAENDIGE Strings — Tailwind scannt diese Datei und
    findet nur komplett dastehende Klassennamen, nie zusammengesetzte. %>
<% ball_colors = {
     b1: { fill: "fill-billiard-ball-white",  stroke: "stroke-billiard-ball-white-edge",  label: "fill-billiard-ball-white-edge" }, # Spielball weiß
     b2: { fill: "fill-billiard-ball-yellow", stroke: "stroke-billiard-ball-yellow-edge", label: "fill-billiard-ball-white-edge" }, # B 2 gelb
     b3: { fill: "fill-billiard-ball-red",    stroke: "stroke-billiard-ball-red-edge",    label: "fill-billiard-ball-white" }       # B 3 rot
   } %>

<% position_type_class = case bc.position_type
                         when "exact"       then "text-success"
                         when "qualitative" then "text-warning"
                         else                    "text-info"
                         end %>

<div class="inline-block align-top m-2.5 p-3 rounded-card border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800">
  <% if title || subtitle %>
    <div class="mb-2 text-[0.95em]">
      <% if subtitle %>
        <span class="text-gray-500 dark:text-gray-400 font-bold uppercase text-[0.85em]"><%= subtitle %></span>
      <% end %>
      <% if title %>
        <span class="text-gray-800 dark:text-gray-100 ml-1.5"><%= title %></span>
      <% end %>
    </div>
  <% end %>

  <svg width="<%= svg_width %>" height="<%= svg_height %>" viewBox="0 0 <%= svg_width %> <%= svg_height %>" xmlns="http://www.w3.org/2000/svg" class="rounded bg-gray-100 dark:bg-gray-900">
    <%# Bandenrahmen (braun) — physische Objektfarbe, kein Dark-Mode-Wechsel %>
    <rect x="0" y="0" width="<%= svg_width %>" height="<%= svg_height %>"
          class="fill-billiard-cushion" rx="6" ry="6" />

    <%# Tuch (grün) %>
    <rect x="<%= padding %>" y="<%= padding %>"
          width="<%= table_w %>" height="<%= table_h %>"
          class="fill-billiard-cloth" />

    <%# Diamantenmarkierungen auf den Banden (je 7 innere entlang der Länge, 3 innere entlang der Breite) %>
    <% (1..7).each do |i| %>
      <% dx = padding + i * table_w / 8.0 %>
      <circle cx="<%= dx %>" cy="<%= padding / 2 %>" r="2" class="fill-billiard-diamond" />
      <circle cx="<%= dx %>" cy="<%= svg_height - padding / 2 %>" r="2" class="fill-billiard-diamond" />
    <% end %>
    <% (1..3).each do |i| %>
      <% dy = padding + i * table_h / 4.0 %>
      <circle cx="<%= padding / 2 %>" cy="<%= dy %>" r="2" class="fill-billiard-diamond" />
      <circle cx="<%= svg_width - padding / 2 %>" cy="<%= dy %>" r="2" class="fill-billiard-diamond" />
    <% end %>

    <%# Bälle %>
    <% bc.balls.each do |role, (nx, ny)| %>
      <% cx = to_svg_x.call(nx) %>
      <% cy = to_svg_y.call(ny) %>
      <% color = ball_colors[role] %>
      <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= ball_radius %>"
              class="<%= color[:fill] %> <%= color[:stroke] %>" stroke-width="2" />
      <text x="<%= cx %>" y="<%= cy + label_font_size / 3 %>" text-anchor="middle"
            font-family="Helvetica, Arial, sans-serif" font-size="<%= label_font_size %>" font-weight="bold"
            class="<%= color[:label] %>">
        <%= role.to_s[-1] %>
      </text>
    <% end %>
  </svg>

  <div class="mt-2 text-[0.8em] font-mono text-gray-500 dark:text-gray-400">
    <div>
      <strong>Tisch:</strong> <%= bc.table_variant %>
      (<%= dims[:length_cm] %> × <%= dims[:width_cm] %> cm)
      &nbsp;|&nbsp;
      <strong>Position-Typ:</strong>
      <span class="<%= position_type_class %>">
        <%= bc.position_type %>
      </span>
      <% if bc.gather_state %>
        &nbsp;|&nbsp;
        <strong>Formation:</strong> <%= bc.gather_state %>
      <% end %>
    </div>
    <div class="mt-1">
      <% bc.balls.each do |role, (nx, ny)| %>
        <span class="mr-3">
          <%= role.to_s.upcase %>: (<%= format('%.3f', nx) %>, <%= format('%.3f', ny) %>)
          ≈ <%= format('%d', nx * dims[:length_cm]) %>×<%= format('%d', ny * dims[:width_cm]) %> cm
        </span>
      <% end %>
    </div>
    <% if bc.biais_degrees || bc.biais_class || bc.flow_direction || bc.orientation %>
      <div class="mt-1 text-gray-400 dark:text-gray-500">
        <% attrs = [
             ("biais=#{bc.biais_degrees}°" if bc.biais_degrees),
             ("class=#{bc.biais_class}" if bc.biais_class),
             ("flow=#{bc.flow_direction}" if bc.flow_direction),
             ("orient=#{bc.orientation}" if bc.orientation)
           ].compact %>
        <%= attrs.join(" | ") %>
      </div>
    <% end %>
  </div>
</div>
