<%# Überschreibt den Standard-Kopf von Administrate NUR fuer player_locals (Quick-Task
    2026-08-30) — um den Knopf zur Massenpflege zu ergaenzen.

    ⚠️ Bewusst der KLEINSTE Eingriff: `_index_header` statt der ganzen `index`-Ansicht. Der
    Rest (Suche, Tabelle, Pagination) bleibt beim Gem, ein Administrate-Update zieht dort
    weiterhin durch. Der Inhalt unten entspricht dem Original des Gems (0.19.0), ergaenzt um
    den einen zusaetzlichen Link. %>

<% content_for(:title) do %>
  <%= display_resource_name(page.resource_name) %>
<% end %>

<header class="main-content__header">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>

  <% if show_search_bar %>
    <%= render(
      "search",
      search_term: search_term,
      resource_name: display_resource_name(page.resource_name)
    ) %>
  <% end %>

  <div class="flex items-center gap-2">
    <%= link_to t("admin.player_locals.bulk.title"),
                bulk_edit_admin_player_locals_path,
                class: "button" %>

    <%= link_to(
      t(
        "administrate.actions.new_resource",
        name: display_resource_name(page.resource_name, singular: true).downcase
      ),
      [:new, namespace, page.resource_path.to_sym],
      class: "button",
    ) if accessible_action?(new_resource, :new) %>
  </div>
</header>
