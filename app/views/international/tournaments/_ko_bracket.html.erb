<%#
  KO-Diagramm der Hauptrunde für internationale Turniere.
  Erwartet locals:
    ko_rounds               – Array<[round_name, Array<Game>]> (bereits sortiert QF→SF→Final)
    game_videos_by_game_id  – Hash{game_id => Video}
  Rendert nur, wenn ko_rounds vorhanden ist (Aufrufer prüft das).
%>
<%
  round_labels = {
    "Round of 32" => "Sechzehntelfinale",
    "Rank 16" => "Sechzehntelfinale",
    "Round of 16" => "Achtelfinale",
    "Rank 8" => "Achtelfinale",
    "Quarter Final" => "Viertelfinale",
    "Semi Final" => "Halbfinale",
    "Final" => "Finale"
  }
%>
<section class="mb-12">
  <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Hauptrunde (K.-o.)</h2>

  <div class="bg-gray-50 dark:bg-gray-900 rounded-lg shadow-inner overflow-x-auto p-4">
    <div class="flex flex-row gap-8 min-w-max">
      <% ko_rounds.each do |round_name, games| %>
        <div class="flex flex-col justify-around gap-6 min-w-[15rem]">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 text-center mb-1">
            <%= round_labels[round_name] || round_name %>
          </h3>

          <% games.each do |game| %>
            <%
              parts = game.game_participations.sort_by { |gp| gp.role.to_i }
              winner_role = game.data.is_a?(Hash) ? game.data["winner_role"] : nil
              video = game_videos_by_game_id[game.id]
            %>
            <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm overflow-hidden">
              <div class="flex items-center justify-between px-2 py-1 bg-gray-100 dark:bg-gray-700/60">
                <span class="text-[11px] font-semibold text-gray-500 dark:text-gray-400">
                  <%= round_labels[round_name] || round_name %> · <%= game.data["umb_match_number"] %>
                </span>
                <% if video %>
                  <%= link_to international_video_path(video),
                        class: "inline-flex items-center text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300",
                        title: "Video ansehen" do %>
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% end %>
              </div>

              <% parts.each_with_index do |gp, idx| %>
                <%
                  is_winner = winner_role.present? && gp.role.to_s == winner_role.to_s
                  nat = (gp.data.is_a?(Hash) && gp.data["nationality"].presence) || gp.player&.nationality
                  flag = country_flag_emoji(nat)
                %>
                <div class="flex items-center gap-2 px-2 py-1.5 text-sm
                            <%= "border-t border-gray-100 dark:border-gray-700" if idx > 0 %>
                            <%= is_winner ? "bg-success-50 dark:bg-success-900/30 font-semibold text-gray-900 dark:text-gray-100" : "text-gray-700 dark:text-gray-300" %>">
                  <span class="w-5 text-center leading-none"><%= flag %></span>
                  <span class="flex-1 truncate" title="<%= gp.player&.fl_name %>"><%= gp.player&.fl_name || "–" %></span>
                  <span class="font-mono tabular-nums text-gray-500 dark:text-gray-400"><%= gp.result %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
