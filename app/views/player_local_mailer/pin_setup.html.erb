<%# ⚠️ Bewusst schlichtes Inline-CSS statt der Tailwind-Token: Mail-Clients laden keine
    Stylesheets und unterstuetzen kaum moderne Selektoren. Eine E-Mail ohne Inline-Styles
    kaeme ungestylt an.

    Die Wache `rake ui:no_hardcoded_hex` greift hier nicht — ihre SCAN_GLOBS umfassen
    `app/views/admin/**/*.erb` und einige Core-CSS-Dateien, nicht Mailer-Vorlagen
    (lib/ui_hex_guard.rb:34, nachgeprueft). Die verwendeten Werte entsprechen den
    Token-Ankern: #0f5f56 = primary (Accent), #57534e = gray-600 (Text sekundaer). %>
<p><%= t(".greeting", name: @name) %></p>

<p><%= t(".intro") %></p>

<p>
  <a href="<%= @url %>" style="display:inline-block;padding:12px 20px;background:#0f5f56;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">
    <%= t(".button") %>
  </a>
</p>

<p style="font-size:13px;color:#57534e;">
  <%= t(".fallback") %><br>
  <%= @url %>
</p>

<p style="font-size:13px;color:#57534e;">
  <%= t(".validity", datum: l(@gueltig_bis)) %>
</p>

<p style="font-size:13px;color:#57534e;">
  <%= t(".no_pin_notice") %>
</p>

<p style="font-size:13px;color:#57534e;">
  <%= t(".ignore") %>
</p>
