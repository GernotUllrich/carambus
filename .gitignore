# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore graphify knowledge-graph output (graph, drift findings, caches).
/graphify-out

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Credentials gehoeren NIE ins Repo — weder die Keys noch die damit
# verschluesselten Dateien. Die Per-Environment-Keys lagen von 2025-08-13 bis
# 2026-08-15 oeffentlich im Repo (config/credentials/*.key, Commit 44cd1b75),
# womit der Inhalt jeder mit ihnen verschluesselten .enc lesbar war. Beide sind
# jetzt ausgeschlossen; eine getrackte .enc ohne Key nuetzt einem frischen
# Checkout ohnehin nichts.
#
# Woher die Dateien stattdessen kommen:
#   production — Scenario-Pipeline (carambus_data/scenarios/<name>/production/
#                credentials, per prepare_deploy in den linked_dir shared/config/credentials)
#   dev/test   — ausserhalb des Repos weitergeben (Backup/Kopie von einem
#                bestehenden Checkout)
config/credentials/*.key
config/credentials/*.yml.enc

# Lokale, szenario-generierte Konfiguration — gehoert nicht ins Repo. Commit 8e21a8f6 hat
# beide bereits aus dem Tracking genommen ("should not be saved to repository"), die
# Ignore-Regel fehlte seither: Sie tauchten in jedem `git status` als untracked auf und
# waeren durch ein `git add .` zurueckgekommen. Vor 8e21a8f6 trug database.yml gefuellte
# username/password-Felder fuer development und test (production war nie betroffen).
#
# Woher sie stattdessen kommen: rake scenario:generate_configs[<name>,<env>] bzw. die
# Vorlagen unter carambus_data/scenarios/<name>/<env>/.
config/database.yml
config/carambus.yml

/public/app
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore test coverage
/coverage/

# Ignore SimpleCov coverage reports
/coverage.data

# Ignore VCR cassettes with real credentials (keep .gitkeep)
# Note: Committed cassettes should have filtered credentials
# If you need to ignore specific cassettes:
# /test/snapshots/vcr/sensitive_*.yml

# Ignore editor-specific files
/.vscode/
/.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore local environment files
.env.local
.env.*.local

# Ignore database files
/*.sqlite3
/*.sqlite3-*
*.sql.gz
*.sql
/doc/doc-local/docker/**/*.sql.gz
/doc/doc-local/docker/**/*.sql

# Ignore MkDocs generated site
/site/

# Ignore uploaded files
/public/uploads

# Ignore scenario-specific generated files (generated from carambus_data/*/config.yml)
/config/deploy/production.rb
/config/environments/development.rb

# Plan 21-10: deploy.rb committed as tracked-repo-file (universal content,
# Variants leben in production.rb stage-file). Overrides ~/.gitignore_global Z.3.
!/config/deploy.rb
/config/scoreboard_url
/env.development
/doc/doc-local/**/*.log
/doc/doc-local/**/*.md
import_all.log
/app/assets/builds/**/*
config/cable.yml
.paul/
.claude/paul-framework/
.claude/commands/paul/
.mcp.json
db/schema_baseline_*.backup

# MCP-Client-Konfiguration (enthält CC-Zugangsdaten — NICHT einchecken).
# Vorlage: .mcp.json.example (tracked).
/.mcp.json

# Bestandsuebersichten: auf dem Server erzeugt (rake coverage:pages), Capistrano-linked_dir
/public/uebersichten

# Artefakte eines lokalen bin/deploy.sh-Laufs (deploy_to zeigt dann auf den Checkout):
# repo/ ist ein bare Mirror-Clone von GitHub, releases/ ein git-archive-Auszug — beides
# jederzeit reproduzierbar und zusammen mehrere hundert MB.
/releases
/repo
